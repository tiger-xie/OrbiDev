<RCC>
  <qresource prefix="/resources">
    <file alias="style/base.qss">resources/style/base.qss</file>
    <file alias="style/setup.qss">resources/style/setup.qss</file>
    <file alias="style/workbench.qss">resources/style/workbench.qss</file>
    <file alias="icon/common/app.svg">resources/icon/common/app.svg</file>
    <file alias="icon/common/check.svg">resources/icon/common/check.svg</file>
    <file alias="icon/common/chevron-down.svg">resources/icon/common/chevron-down.svg</file>
    <file alias="style/window.qss">resources/style/window.qss</file>
    <file alias="icon/window/maximize.svg">resources/icon/window/maximize.svg</file>
    <file alias="icon/window/close.svg">resources/icon/window/close.svg</file>
    <file alias="icon/window/minimize.svg">resources/icon/window/minimize.svg</file>
    <file alias="icon/window/restore.svg">resources/icon/window/restore.svg</file>
    <file alias="icon/setup/copy.svg">resources/icon/setup/copy.svg</file>
    <file alias="icon/setup/export.svg">resources/icon/setup/export.svg</file>
    <file alias="icon/setup/error.svg">resources/icon/setup/error.svg</file>
    <file alias="icon/setup/user.svg">resources/icon/setup/user.svg</file>
    <file alias="icon/setup/folder.svg">resources/icon/setup/folder.svg</file>
  </qresource>
</RCC>
